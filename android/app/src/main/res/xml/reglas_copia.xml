<?xml version="1.0" encoding="utf-8"?>
<!-- Nada de esta app sale del equipo: ni en la copia de Google ni al pasar los datos a otro
     dispositivo. Aquí están la sesión y el certificado del titular (Android 12 o superior;
     en los anteriores lo hace android:allowBackup="false"). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
